# Copy to app/.env (gitignored). docker compose auto-loads this file.
#   cp app/.env.example app/.env  &&  edit JWT_SECRET
#
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: override the host path where the SQLite DB is bind-mounted.
# Defaults to /DATA/AppData/swissygo-dev/data (CasaOS-friendly).
# SWISSYGO_DATA_DIR=/DATA/AppData/swissygo-dev/data
