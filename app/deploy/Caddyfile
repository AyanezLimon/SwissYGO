# SwissYGO — Caddyfile for your EXISTING Caddy container (reused, not a new one).
# Behind the Cloudflare tunnel (TLS terminated by Cloudflare → plain http here).
#
# Fail-safe by design: only torneodev is special-cased. EVERYTHING else (torneo
# and any other host that reaches this Caddy) falls through to the catch-all and
# is served exactly as the stock config does today — so prod can't break from a
# hostname mismatch.
#
# One-time: in the CasaOS Caddy app add two bind mounts and recreate:
#   <host>/Caddyfile           -> /etc/caddy/Caddyfile
#   /DATA/AppData/swissygo-dev -> /srv/swissygo-dev
# Prod's existing mount (/DATA/AppData/swissygo -> /usr/share/caddy) stays.

{
	auto_https off
}

torneodev.elbunkers.com:80 {
	# Dev site: never let Cloudflare/edge cache assets (avoids stale CSS/JS while
	# iterating). Cloudflare honors no-store and won't cache.
	header Cache-Control "no-store"

	# API → backend container (only relevant once the API is running). Caddy is on
	# the default docker bridge; the host is reachable at the bridge gateway.
	handle /api/* {
		reverse_proxy 172.17.0.1:8787
	}
	handle {
		root * /srv/swissygo-dev
		try_files {path} /index.html
		file_server
	}
}

# Catch-all: torneo.elbunkers.com and anything else → prod, unchanged.
:80 {
	root * /usr/share/caddy
	file_server
}
