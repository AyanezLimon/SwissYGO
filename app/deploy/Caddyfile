# SwissYGO — Caddyfile for your EXISTING Caddy container (reused, not a new one).
# Two sites behind the Cloudflare tunnel (which terminates TLS, so plain http):
#
#   torneo.elbunkers.com     prod — the single SwissYGO.html (unchanged)
#   torneodev.elbunkers.com  dev  — the static overhaul + /api → backend container
#
# One-time: in the CasaOS Caddy app, add two volume mounts and reload Caddy:
#   <this file>            -> /etc/caddy/Caddyfile
#   /DATA/AppData/swissygo-dev -> /srv/swissygo-dev   (the dev static files)
# Prod's existing mount (/DATA/AppData/swissygo -> /usr/share/caddy) stays as is.

{
	# Behind the tunnel; certs are handled by Cloudflare, not Caddy.
	auto_https off
}

http://torneo.elbunkers.com {
	root * /usr/share/caddy
	file_server
}

http://torneodev.elbunkers.com {
	# API → backend container (published on the host; reachable from Caddy on the
	# default bridge via the docker0 gateway). Only needed once you run the API.
	handle /api/* {
		reverse_proxy 172.17.0.1:8787
	}
	# Static SPA, with SPA-style fallback to index.html.
	handle {
		root * /srv/swissygo-dev
		try_files {path} /index.html
		file_server
	}
}
