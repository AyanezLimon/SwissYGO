# SwissYGO backend config (copy to .env on the Pi; never commit real secrets).
PORT=8787
HOST=127.0.0.1
DB_PATH=/opt/swissygo-dev/data/swissygo.sqlite
# Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
